{
  "name": "lark-base-word-print-plugin",
  "version": "1.0.0",
  "description": "飞书多维表格「设计 Word 模板 + 填充字段数据」打印插件",
  "type": "module",
  "output": "dist",
  "scripts": {
    "dev": "vite",
    "build": "npm run gen:template && tsc -b && vite build && node scripts/inject-version.mjs",
    "preview": "vite preview",
    "gen:template": "node scripts/generate-template.mjs"
  },
  "dependencies": {
    "@lark-base-open/js-sdk": "^1.0.2",
    "dayjs": "^1.11.13",
    "docx-preview": "^0.3.4",
    "docxtemplater": "^3.50.0",
    "docxtemplater-image-module-free": "^1.1.1",
    "file-saver": "^2.0.5",
    "idb": "^8.0.0",
    "pizzip": "^3.1.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "docx": "^9.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
